# 本地 Ollama
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1

# 部署时的 API 认证（留空则跳过认证）
AGENT_API_KEY=

# 日志级别
LOG_LEVEL=INFO

# LangSmith 可观测性（可选）
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-chat-cli

# 视觉模型（可选）
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=llava:latest
