[Unit]
Description=LLM Agent API
After=network.target ollama.service

[Service]
Type=simple
User=xuwei
WorkingDirectory=/home/xuwei/llm-chat-cli
Environment="PATH=/home/xuwei/llm-chat-cli/.venv/bin:/usr/bin"
EnvironmentFile=/home/xuwei/llm-chat-cli/.env
ExecStart=/home/xuwei/llm-chat-cli/.venv/bin/uvicorn app_fastapi:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
